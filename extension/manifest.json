{
  "manifest_version": 3,
  "name": "Takealot to Amazon Comparator",
  "version": "1.0",
  "permissions": ["activeTab", "scripting"], 
  "host_permissions": ["https://www.amazon.com/*"], 
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.takealot.com/*/PLID*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_icon": "icon.png"
  }
}