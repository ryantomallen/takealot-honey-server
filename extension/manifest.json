{
  "manifest_version": 3,
  "name": "Takealot to Amazon Comparator",
  "version": "1.0",
  "description": "Checks Amazon prices when viewing Takealot products.",
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": ["*://*.takealot.com/*/PLID*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "action": {
    "default_icon": "icon.png"
  }
}